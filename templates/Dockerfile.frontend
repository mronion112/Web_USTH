# Dockerfile phục vụ frontend React (Vite build, nginx serve).
# Build context là thư mục gốc repo. VITE_API_URL chốt lúc build
# vì Vite nhúng vào bundle tĩnh, không đọc env lúc chạy.
#
# Chạy từ thư mục gốc:
#   docker build --build-arg VITE_API_URL=http://localhost:8080 -f templates/Dockerfile.frontend .
# Hoặc qua compose (khuyến nghị):
#   docker compose -f templates/docker-compose.yml --profile app up --build

FROM node:22-alpine AS build
WORKDIR /workspace
ARG VITE_API_URL=http://localhost:8080
ENV VITE_API_URL=$VITE_API_URL
COPY frontend/lunara/package.json frontend/lunara/package-lock.json frontend/lunara/
RUN cd frontend/lunara && npm ci
COPY frontend/lunara frontend/lunara/
RUN cd frontend/lunara && npm run build

FROM nginx:alpine
COPY templates/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/lunara/dist /usr/share/nginx/html
EXPOSE 80
