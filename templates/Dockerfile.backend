# Dockerfile chung cho mọi module backend Spring Boot.
# Build context là thư mục gốc repo. Không hardcode biến môi trường,
# mọi cấu hình đọc từ env_file của service backend trong docker-compose.yml.
#
# Chạy từ thư mục gốc:
#   docker build -f templates/Dockerfile.backend .
# Hoặc qua compose (khuyến nghị):
#   docker compose -f templates/docker-compose.yml --profile app up --build

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY backend/pom.xml backend/
COPY backend/mvnw backend/
COPY backend/mvnw.cmd backend/
COPY backend/.mvn backend/.mvn/
RUN chmod +x backend/mvnw
RUN --mount=type=cache,target=/root/.m2 \
    ./backend/mvnw -B -f backend/pom.xml dependency:go-offline
COPY backend/src backend/src/
RUN --mount=type=cache,target=/root/.m2 \
    ./backend/mvnw -B -f backend/pom.xml package -DskipTests

FROM eclipse-temurin:21-jre
# Múi giờ cố định theo quy ước dự án (email ICS, frontend format đều dùng VN).
# Không set thì JVM mặc định UTC, timestamp do server sinh sẽ lệch 7 giờ.
ENV TZ=Asia/Ho_Chi_Minh
WORKDIR /app
COPY --from=build /workspace/backend/target/*.jar app.jar
COPY docs /app/docs
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
