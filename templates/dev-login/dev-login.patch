@@ -0,0 +1,136 @@
+package com.kevin.lunaraspa.authentication_account;
+
+import com.kevin.lunaraspa.authentication_account.entity.Account;
+import com.kevin.lunaraspa.authentication_account.entity.Role;
+import com.kevin.lunaraspa.authentication_account.repository.AccountRepository;
+import com.kevin.lunaraspa.authentication_account.repository.RoleRepository;
+import com.kevin.lunaraspa.authentication_account.security.JwtUtils;
+import com.kevin.lunaraspa.core.exception.AppException;
+import com.kevin.lunaraspa.core.exception.AuthErrorCode;
+import com.kevin.lunaraspa.core.http.ResponseBuilder;
+import com.kevin.lunaraspa.profiles.entity.CustomerProfile;
+import com.kevin.lunaraspa.profiles.entity.StaffProfile;
+import com.kevin.lunaraspa.profiles.repository.CustomerProfileRepository;
+import com.kevin.lunaraspa.profiles.repository.StaffProfileRepository;
+import lombok.RequiredArgsConstructor;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.http.ResponseEntity;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+/**
+ * Đăng nhập giả cho môi trường local/dev, KHÔNG dùng cho production.
+ *
+ * <p>Chỉ tồn tại khi {@code app.dev-login.enabled=true}. Tự tạo tài khoản ảo theo
+ * email + role rồi trả JWT, để test luồng cần quyền (ví dụ nhân viên thu tiền)
+ * mà không phải cấu hình Google OAuth. Không có kiểm tra mật khẩu, nên tuyệt đối
+ * không bật ngoài local.
+ */
+@RestController
+@RequestMapping("/dev/auth")
+@RequiredArgsConstructor
+@ConditionalOnProperty(prefix = "app.dev-login", name = "enabled", havingValue = "true")
+public class DevAuthController {
+
+    private static final Set<String> ALLOWED_ROLES = Set.of(
+            "OWNER", "MANAGER", "RECEPTIONIST", "THERAPIST", "ACCOUNTANT", "CUSTOMER");
+
+    private final AccountRepository accountRepository;
+    private final RoleRepository roleRepository;
+    private final CustomerProfileRepository customerProfileRepository;
+    private final StaffProfileRepository staffProfileRepository;
+    private final JwtUtils jwtUtils;
+
+    @PostMapping("/login")
+    @Transactional
+    public ResponseEntity<Object> login(@RequestBody Map<String, String> request) {
+        String email = normalizeEmail(request.get("email"));
+        String roleCode = normalizeRole(request.get("roleCode"));
+
+        Role role = roleRepository.findByCode(roleCode)
+                .orElseThrow(() -> new AppException(AuthErrorCode.ACCOUNT_NOT_FOUND));
+
+        Account account = accountRepository.findByEmail(email)
+                .map(existing -> updateRole(existing, role))
+                .orElseGet(() -> createAccount(email, role));
+
+        ensureProfile(account, roleCode);
+
+        String accessToken = jwtUtils.generateAccessToken(account.getEmail(), roleCode);
+        String refreshToken = jwtUtils.generateRefreshToken(account.getEmail(), roleCode);
+
+        return ResponseBuilder.ok(Map.of(
+                "accessToken", accessToken,
+                "refreshToken", refreshToken,
+                "email", account.getEmail(),
+                "displayName", account.getDisplayName(),
+                "role", roleCode
+        ), "Dev login successfully");
+    }
+
+    private Account updateRole(Account account, Role role) {
+        account.setRole(role);
+        account.setIsActive(true);
+        return accountRepository.saveAndFlush(account);
+    }
+
+    private Account createAccount(String email, Role role) {
+        String displayName = email.substring(0, email.indexOf('@'));
+        Account account = Account.builder()
+                .email(email)
+                .displayName(displayName)
+                .role(role)
+                .isActive(true)
+                .build();
+        return accountRepository.saveAndFlush(account);
+    }
+
+    private void ensureProfile(Account account, String roleCode) {
+        if ("CUSTOMER".equals(roleCode)) {
+            if (customerProfileRepository.findById(account.getId()).isEmpty()) {
+                customerProfileRepository.saveAndFlush(CustomerProfile.builder()
+                        .account(account)
+                        .phone("")
+                        .build());
+            }
+            return;
+        }
+        if (staffProfileRepository.findById(account.getId()).isEmpty()) {
+            staffProfileRepository.saveAndFlush(StaffProfile.builder()
+                    .account(account)
+                    .employeeCode("DEV-" + UUID.randomUUID().toString().substring(0, 8).toUpperCase(Locale.ROOT))
+                    .jobTitle(roleCode)
+                    .isBookable(true)
+                    .build());
+        }
+    }
+
+    private String normalizeEmail(String email) {
+        if (email == null || email.isBlank() || !email.contains("@")) {
+            throw new AppException(AuthErrorCode.INVALID_TOKEN);
+        }
+        return email.trim().toLowerCase(Locale.ROOT);
+    }
+
+    private String normalizeRole(String roleCode) {
+        if (roleCode == null || roleCode.isBlank()) {
+            throw new AppException(AuthErrorCode.INVALID_TOKEN);
+        }
+        String normalized = roleCode.trim().toUpperCase(Locale.ROOT);
+        if (normalized.startsWith("ROLE_")) {
+            normalized = normalized.substring(5);
+        }
+        if (!ALLOWED_ROLES.contains(normalized)) {
+            throw new AppException(AuthErrorCode.INVALID_TOKEN);
+        }
+        return normalized;
+    }
+}
