+}
+
+// Đăng nhập giả cho local/dev. Chỉ hoạt động khi backend bật APP_DEV_LOGIN_ENABLED.
+export async function devLogin(email: string, roleCode: string): Promise<DevLoginResult> {
+  const response = await fetch(`${API_ORIGIN}/dev/auth/login`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ email, roleCode }),
+  });
+  const body = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new ApiError(response.status, body?.message || `HTTP ${response.status}`);
+  }
+  const data = (body && typeof body === 'object' && 'data' in body ? body.data : body) as DevLoginResult;
+  setStoredToken(data.accessToken);
+  if (data.refreshToken) setStoredRefreshToken(data.refreshToken);
+  return data;
+}
