@@ -0,0 +1,87 @@
+import React, { useState } from 'react';
+import { Link } from 'react-router-dom';
+import { devLogin } from '@/lib/api';
+import { ROLE_HOME } from '@/lib/access-control';
+import type { RoleCode } from '@/types';
+
+const ROLES: RoleCode[] = ['OWNER', 'MANAGER', 'RECEPTIONIST', 'ACCOUNTANT', 'THERAPIST', 'CUSTOMER'];
+
+const DEV_LOGIN_ENABLED = import.meta.env.VITE_DEV_LOGIN === 'true';
+
+export const DevLoginPage: React.FC = () => {
+  const [email, setEmail] = useState('dev@lunara.local');
+  const [role, setRole] = useState<RoleCode>('OWNER');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+
+  if (!DEV_LOGIN_ENABLED) {
+    return (
+      <div className="min-h-screen bg-[#F8F9F5] flex items-center justify-center p-6 font-body">
+        <div className="w-full max-w-md rounded-3xl bg-white border border-[#E2E8E3] p-8 text-center space-y-3">
+          <h2 className="font-display text-xl font-semibold text-[#14271C]">Dev login đang tắt</h2>
+          <p className="text-xs text-[#526056]">Đặt VITE_DEV_LOGIN=true khi build frontend để dùng chức năng này.</p>
+          <Link to="/" className="block text-xs text-[#8EAA97] hover:underline">← Quay lại trang chủ</Link>
+        </div>
+      </div>
+    );
+  }
+
+  const submit = async (event: React.FormEvent) => {
+    event.preventDefault();
+    setBusy(true);
+    setError('');
+    try {
+      await devLogin(email.trim(), role);
+      window.location.assign(ROLE_HOME[role] || '/');
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'Đăng nhập giả thất bại.');
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="min-h-screen bg-[#F8F9F5] flex flex-col items-center justify-center p-6 font-body">
+      <Link to="/" className="font-display text-4xl font-semibold text-[#14271C] mb-8">Lunara</Link>
+      <form onSubmit={submit} className="w-full max-w-md rounded-3xl bg-white border border-[#E2E8E3] shadow-luxury p-8 space-y-5">
+        <div className="space-y-1 text-center">
+          <h2 className="font-display text-2xl font-semibold text-[#14271C]">Đăng nhập giả (dev)</h2>
+          <p className="text-xs text-[#526056]">Tạo tài khoản ảo theo email và role. Chỉ dùng ở local.</p>
+        </div>
+
+        {error && <p role="alert" className="text-sm text-red-700">{error}</p>}
+
+        <label className="block space-y-1.5">
+          <span className="text-xs font-semibold uppercase tracking-wider text-[#8EAA97]">Email</span>
+          <input
+            type="email"
+            required
+            value={email}
+            onChange={(event) => setEmail(event.target.value)}
+            className="w-full rounded-xl border border-[#D9E5DC] px-3.5 py-2.5 text-sm text-[#14271C] focus:outline-none focus:border-[#1E3B2B]"
+          />
+        </label>
+
+        <label className="block space-y-1.5">
+          <span className="text-xs font-semibold uppercase tracking-wider text-[#8EAA97]">Role</span>
+          <select
+            value={role}
+            onChange={(event) => setRole(event.target.value as RoleCode)}
+            className="w-full rounded-xl border border-[#D9E5DC] px-3.5 py-2.5 text-sm text-[#14271C] focus:outline-none focus:border-[#1E3B2B]"
+          >
+            {ROLES.map((value) => <option key={value} value={value}>{value}</option>)}
+          </select>
+        </label>
+
+        <button
+          type="submit"
+          disabled={busy}
+          className="w-full h-12 rounded-xl bg-[#1E3B2B] text-white hover:bg-[#14271C] font-semibold text-sm disabled:opacity-60"
+        >
+          {busy ? 'Đang đăng nhập…' : 'Đăng nhập'}
+        </button>
+
+        <Link to="/" className="block text-xs text-center text-[#8EAA97] hover:underline">← Quay lại trang chủ</Link>
+      </form>
+    </div>
+  );
+};
