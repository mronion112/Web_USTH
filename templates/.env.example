# Copy to templates/.env and fill real values. Never commit the live .env.
# cp templates/.env.example templates/.env

# --- MySQL (service: db) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=lunara_spa
MYSQL_USER=lunara
MYSQL_PASSWORD=change-me-app
DB_PORT=3306

# --- Backend Spring Boot (service: backend) ---
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/lunara_spa?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=lunara
SPRING_DATASOURCE_PASSWORD=change-me-app
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
FRONTEND_URL=http://localhost:5173

# --- Frontend React (service: frontend) ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
