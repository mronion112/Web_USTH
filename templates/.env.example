# Sao chép sang templates/.env và điền giá trị thật. Không commit file .env live.
# cp templates/.env.example templates/.env

# --- MySQL (service: db) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=lunara_spa
MYSQL_USER=lunara
MYSQL_PASSWORD=change-me-app
DB_PORT=3306

# --- Redis (service: redis) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backend Spring Boot (service: backend) ---
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/lunara_spa?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=lunara
SPRING_DATASOURCE_PASSWORD=change-me-app
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GEMINI_API_KEY=change-me
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHATBOT_DOCS_PATH=/app/docs
CHATBOT_CHUNK_SIZE=1600
CHATBOT_CHUNK_OVERLAP=250
CHATBOT_DEFAULT_TOP_K=5
CHROMA_PORT=8000
CHROMA_ENABLED=false
CHROMA_URL=http://localhost:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION=lunara_spa_knowledge
CHROMA_API_KEY=
CHROMA_STARTUP_INDEXING=false
CHROMA_UPSERT_BATCH_SIZE=100
FRONTEND_URL=http://localhost:5173

# --- Frontend React (service: frontend) ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
