# --- LLM: 9router proxy (OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=sk-<9router-key>
LLM_MODEL=cx/gpt-5.6-sol
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_ITERATIONS=6

# --- TypeSafe (bo trong = tu tat, agent van chay binh thuong) ---
TYPESAFE_ENABLED=true
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=20

# --- Spring Backend ---
BACKEND_BASE_URL=http://localhost:8080
BACKEND_TIMEOUT_SECONDS=10
BACKEND_MAX_RETRIES=2

# --- Agent service ---
AGENT_PORT=8090
AGENT_ENV=local
AGENT_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# --- Knowledge corpus ---
KNOWLEDGE_DIR=app/data/knowledge
KNOWLEDGE_INCLUDE_DRAFT=true
KNOWLEDGE_MAX_RESULTS=5

# --- Gioi han tool ---
MAX_DATE_RANGE_DAYS=31
MAX_PAGE_SIZE=50
MAX_QUERY_CHARS=200
