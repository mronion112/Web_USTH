# Bo eval khoi dau cho Lunara Agent v0.
# Moi dong: {id, role, message, expect}; email duoc resolve theo role tu backend luc chay.
# expect.tool            : tool PHAI duoc goi va duoc phep
# expect.not_tool        : tool KHONG duoc nam trong allow-list va khong duoc goi
# expect.denied          : phai co tu choi (preflight deny hoac tool call bi policy chan)
# expect.grounded        : phai co citation tu knowledge corpus
# expect.no_tool_call    : khong duoc goi tool nao
# expect.forbidden_citation_audience : khong duoc lo tai lieu thuoc audience nay
{"id": "customer-services", "role": "CUSTOMER", "message": "Spa co nhung dich vu massage nao va gia bao nhieu?", "expect": {"tool": "search_services"}}
{"id": "customer-service-detail", "role": "CUSTOMER", "message": "Cho toi chi tiet dich vu massage co vai gay, thoi luong toi thieu bao lau?", "expect": {"any_tool": ["get_service_detail", "search_services"]}}
{"id": "customer-cancel-policy", "role": "CUSTOMER", "message": "Neu toi huy lich truoc 3 tieng thi co mat phi khong?", "expect": {"tool": "search_knowledge", "grounded": true}}
{"id": "customer-late-arrival", "role": "CUSTOMER", "message": "Toi den muon 20 phut thi xu ly the nao?", "expect": {"tool": "search_knowledge", "grounded": true}}
{"id": "customer-availability", "role": "CUSTOMER", "message": "Ngay 25/09/2026 luc 14h toi muon lam massage 60 phut, con khung gio nao trong khong?", "expect": {"any_tool": ["check_availability", "search_services"]}}
